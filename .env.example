# Model provider: mock | groq | anthropic | openai
# 'mock' needs no key and runs deterministically (used for reproducible evals + offline demo)
MODEL_PROVIDER=mock

# Model name (provider-specific). Ignored in mock mode.
# groq example:      llama-3.3-70b-versatile
# anthropic example: claude-3-5-sonnet-latest
MODEL_NAME=llama-3.3-70b-versatile

# Data source: sample (bundled filings) | live (EDGAR + metrics API)
DATA_MODE=sample

# Live metrics provider: fmp | alphavantage  (both have free tiers)
METRICS_PROVIDER=fmp
FMP_API_KEY=
ALPHAVANTAGE_API_KEY=
# SEC EDGAR requires a descriptive User-Agent with your email:
SEC_USER_AGENT=your-name your-email@example.com

# RAG embeddings: lexical (BM25+TF-IDF, offline) | real (sentence-transformers)
RAG_EMBEDDINGS=lexical

# API keys (only needed for the matching provider / live mode)
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Critic loop: max revise cycles before forcing a stop
MAX_REVISIONS=2
